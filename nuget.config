<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Microsoft.DiaSymReader.Converter (Windows PDB -> portable PDB) is published only on the public dotnet-tools feed of
    the .NET team; everything else comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.DiaSymReader.Converter" />
    </packageSource>
  </packageSourceMapping>
</configuration>
