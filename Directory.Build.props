<Project>

  <!-- One version for everything that ships: the adapter, the .NET tool and (via build/set-version) the VS Code extension. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>dvislobokov</Authors>
    <Copyright>Copyright (c) 2026 dvislobokov and dotnet-debugger contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dvislobokov/dotnet-debugger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dvislobokov/dotnet-debugger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Everything targets the oldest supported runtime and rolls forward to whatever is installed: the adapter has to start
    on a machine that has nothing but .NET 8 (a locked down corporate environment), and equally on one with only .NET 10.
    The debuggees of the tests follow the same rule, so the suite runs wherever the repository builds.
  -->
  <PropertyGroup>
    <DebuggerTargetFramework>net8.0</DebuggerTargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
