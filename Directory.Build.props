<Project>

  <!-- One version for everything that ships: the adapter, the .NET tool and (via build/set-version) the VS Code extension. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>dvislobokov</Authors>
    <Copyright>Copyright (c) 2026 dvislobokov and dotnet-debugger contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dvislobokov/dotnet-debugger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dvislobokov/dotnet-debugger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
