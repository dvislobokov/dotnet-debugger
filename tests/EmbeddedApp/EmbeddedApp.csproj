<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built the way CI builds ship: sources embedded in the PDB and paths mapped to a location that does not exist on
    this machine. Used to test the "source" request and sourceFileMap.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DebuggerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <PathMap>$(MSBuildProjectDirectory)=/_/embedded</PathMap>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

</Project>
