<Project Sdk="Microsoft.NET.Sdk">

  <!-- Top-level statements with an await: the real entry point is a compiler-generated stub without sequence points. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DebuggerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
