<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library whose PDB the tests take away from next to the dll and publish through a symbol store instead. -->
  <PropertyGroup>
    <TargetFramework>$(DebuggerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
