<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DebuggerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- the Windows-only debuggees below are outside the solution and must still get its configuration -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetDebugger.Protocol\DotnetDebugger.Protocol.csproj" />
    <!-- Build-order only: the tests start these as separate processes. -->
    <ProjectReference Include="..\..\src\DotnetDebugger.Adapter\DotnetDebugger.Adapter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestApp\TestApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\EmbeddedApp\EmbeddedApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SymbolApp\SymbolApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AsyncMainApp\AsyncMainApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The .NET Framework debuggee only exists on Windows; elsewhere FrameworkTests skip themselves. The debuggees of this
    and the next group are deliberately not in the solution: built from it as well, they would be built twice at the
    same time (once more with TargetFramework=net48) into the same obj folder.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\TestAppFx\TestAppFx.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net48" />
    <ProjectReference Include="..\TestAppFxFull\TestAppFxFull.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net48" />
    <ProjectReference Include="..\AsyncMainAppFull\AsyncMainAppFull.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 32-bit programs, which the adapter has to refuse (ThirtyTwoBitTests, Windows only). -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\TestAppFx32\TestAppFx32.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net48" />
    <ProjectReference Include="..\TestAppFxAnyCpu32\TestAppFxAnyCpu32.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net48" />
    <ProjectReference Include="..\TestApp32\TestApp32.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
