<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET (Core) debuggee as a 32-bit process (FrameworkX86Tests, Windows only): the sources of TestApp, built
    self-contained for win-x86 so that no x86 .NET runtime has to be installed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DebuggerTargetFramework)</TargetFramework>
    <AssemblyName>TestApp32</AssemblyName>
    <RootNamespace>TestApp</RootNamespace>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TestApp\*.cs" />
  </ItemGroup>

</Project>
